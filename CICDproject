            pathType: Prefix
            backend:
              service:
                name: monitoring-grafana
                port:
                  number: 80
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-api
  namespace: payment-system
  labels:
    app: payment-api
spec:
  replicas: 2
  selector:
    matchLabels:
      app: payment-api
  template:
    metadata:
      labels:
        app: payment-api
    spec:
      initContainers:
        - name: db-migration
          image: postgres:15-alpine
          command:
            - sh
            - -c
            - |
              until psql "postgresql://payuser:PaySecurePassword123!@postgres:5432/paymentdb" -c '\q'; do
                echo "Waiting for PostgreSQL database to be ready..."
                sleep 2
              done
              echo "Creating transactions table..."
              psql "postgresql://payuser:PaySecurePassword123!@postgres:5432/paymentdb" -c "
                CREATE TABLE IF NOT EXISTS transactions (
                  id SERIAL PRIMARY KEY,
                  account_id VARCHAR(50),
                  amount DECIMAL(10,2),
                  status VARCHAR(20),
                  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                );"
      containers:
        - name: payment-api
          image: ghcr.io/arunkk98/payment-api:latest
          ports:
            - containerPort: 5678
          readinessProbe:
            httpGet:
              path: /health
              port: 5678
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 5678
            initialDelaySeconds: 10
            periodSeconds: 15
